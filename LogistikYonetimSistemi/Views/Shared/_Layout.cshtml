<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Lojistik YS</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/app.css" />
</head>
<body>
<div class="d-flex">

    <!-- ── Sidebar ─────────────────────────────────────────────── -->
    <nav id="sidebar">
        <a class="sidebar-brand" href="/Dashboard">
            <div class="brand-icon"><i class="bi bi-pc-display-horizontal"></i></div>
            <div class="brand-text">Lojistik <span>YS</span></div>
        </a>

        <div class="sidebar-user">
            <div class="user-name"><i class="bi bi-person-circle me-1"></i>@User.Identity?.Name</div>
            <div class="user-role">@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</div>
        </div>

        <ul class="nav flex-column mt-2 px-1">
            <li class="nav-section">Genel</li>
            <li>
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")"
                   href="/Dashboard">
                    <span class="nav-icon"><i class="bi bi-speedometer2"></i></span> Dashboard
                </a>
            </li>

            @if (!User.IsInRole("Customer"))
            {
            <li class="nav-section">Envanter</li>
            <li>
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Product" ? "active" : "")"
                   href="/Product">
                    <span class="nav-icon"><i class="bi bi-cpu"></i></span> Ürünler
                </a>
            </li>
            <li>
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Stock" ? "active" : "")"
                   href="/Stock">
                    <span class="nav-icon"><i class="bi bi-bar-chart-line"></i></span> Stok Yönetimi
                </a>
            </li>
            }

            <li class="nav-section">@(User.IsInRole("Courier") ? "Teslimatlar" : "Satış")</li>
            <li>
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Order" ? "active" : "")"
                   href="/Order">
                    <span class="nav-icon"><i class="bi @(User.IsInRole("Courier") ? "bi-truck" : "bi-cart3")"></i></span>
                    @(User.IsInRole("Courier") ? "Teslimat Listesi" : "Siparişler")
                </a>
            </li>

            @if (User.IsInRole("Admin"))
            {
            <li class="nav-section">Yönetim</li>
            <li>
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "User" ? "active" : "")"
                   href="/User">
                    <span class="nav-icon"><i class="bi bi-people"></i></span> Kullanıcılar
                </a>
            </li>
            <li>
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Log" ? "active" : "")"
                   href="/Log">
                    <span class="nav-icon"><i class="bi bi-journal-text"></i></span> Sistem Logları
                </a>
            </li>
            }
        </ul>

        <div class="sidebar-footer">
            <a class="btn-logout" href="/Account/Logout">
                <i class="bi bi-box-arrow-left"></i> Çıkış Yap
            </a>
        </div>
    </nav>

    <!-- ── Page wrapper ─────────────────────────────────────────── -->
    <div id="page-wrapper">
        <header id="topbar">
            <span class="page-title">@ViewData["Title"]</span>
            <div class="ms-auto d-flex gap-2 align-items-center">
                <span class="text-muted" style="font-size:.8rem;">
                    <i class="bi bi-calendar3 me-1"></i>@DateTime.Now.ToString("dd MMM yyyy")
                </span>
            </div>
        </header>

        <main class="content">
            @RenderBody()
        </main>
    </div>
</div>

<!-- ── Toast container ──────────────────────────────────────────── -->
<div id="toastContainer">
@if (TempData["Success"] != null)
{
    <div class="app-toast toast-success">
        <span class="toast-icon text-success"><i class="bi bi-check-circle-fill"></i></span>
        <span class="toast-text">@TempData["Success"]</span>
        <button type="button" class="btn-close btn-close-sm ms-auto" onclick="this.closest('.app-toast').remove()"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="app-toast toast-danger">
        <span class="toast-icon text-danger"><i class="bi bi-exclamation-circle-fill"></i></span>
        <span class="toast-text">@TempData["Error"]</span>
        <button type="button" class="btn-close btn-close-sm ms-auto" onclick="this.closest('.app-toast').remove()"></button>
    </div>
}
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
// Toast'ları 4 saniye sonra otomatik kapat
document.querySelectorAll('.app-toast').forEach(t => setTimeout(() => t.remove(), 4000));
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
