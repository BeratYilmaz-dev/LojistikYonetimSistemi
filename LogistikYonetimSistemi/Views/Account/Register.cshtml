@{
    Layout = null;
    ViewData["Title"] = "Kayıt Ol";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8"/>
    <title>Kayıt Ol — Lojistik YS</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"/>
    <link rel="stylesheet" href="~/css/app.css"/>
</head>
<body>
<div class="login-page">

    <div class="login-panel">
        <div class="login-logo"><i class="bi bi-person-plus-fill"></i></div>
        <h1>Kayıt Ol</h1>
        <p>Birkaç adımda ücretsiz<br/>hesabınızı oluşturun</p>
        <div style="margin-top:2rem;width:100%;position:relative;z-index:1;">
            @foreach (var item in new[]{"Siparişlerinizi takip edin","Kargo durumunu görün","İade başlatın","Faturalarınıza erişin"})
            {
                <div style="display:flex;align-items:center;gap:.5rem;color:#d1d5db;font-size:.84rem;padding:.3rem 0;">
                    <i class="bi bi-check-circle-fill" style="color:#3b82f6;font-size:.85rem;"></i>
                    @item
                </div>
            }
        </div>
    </div>

    <div class="login-main">
        <div class="login-box" style="max-width:460px;">
            <h2>Hesap Oluştur</h2>
            <p class="text-muted mb-4" style="font-size:.88rem;">Müşteri olarak sisteme katılın</p>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger py-2 mb-3">
                    <i class="bi bi-exclamation-circle me-2"></i>@ViewBag.Error
                </div>
            }

            <form method="post" action="/Account/Register">
                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label">Kullanıcı Adı</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-person"></i></span>
                            <input name="username" type="text" class="form-control" placeholder="kullanici.adi" required autofocus/>
                        </div>
                    </div>
                    <div class="col-12">
                        <label class="form-label">E-posta</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                            <input name="email" type="email" class="form-control" placeholder="ad@mail.com"/>
                        </div>
                    </div>
                    <div class="col-12">
                        <label class="form-label">Teslimat Adresi</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-geo-alt"></i></span>
                            <input name="address" type="text" class="form-control" placeholder="İstanbul, Kadıköy"/>
                        </div>
                    </div>
                    <div class="col-6">
                        <label class="form-label">Şifre</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-lock"></i></span>
                            <input name="password" type="password" class="form-control" placeholder="min. 6 karakter" required minlength="6"/>
                        </div>
                    </div>
                    <div class="col-6">
                        <label class="form-label">Şifre Tekrar</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-lock-fill"></i></span>
                            <input name="confirmPassword" type="password" class="form-control" placeholder="••••••••" required/>
                        </div>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2 fw-bold mt-4">
                    <i class="bi bi-person-check me-2"></i>Kayıt Ol
                </button>
            </form>

            <hr class="my-3"/>
            <div class="text-center" style="font-size:.875rem;">
                Zaten hesabınız var mı?
                <a href="/Account/Login" class="fw-semibold text-primary">Giriş Yapın</a>
            </div>
        </div>
    </div>
</div>
</body>
</html>
